# ==========================================
# ArcOS System Properties (emerald / mt6789)
# ==========================================

# ArcOS Identity
ro.arcos.version=V0.1-ALPHA
ro.arcos.device=emerald
ro.arcos.build.version=16.0
ro.modversion=ArcOS-V0.1-ALPHA-emerald

# Display & Scaling: 374 DP (462 DPI on 1080x2400)
ro.sf.lcd_density=462
persist.sys.sf.lcd_density=462

# SurfaceFlinger & 120Hz First-Boot Blackscreen Fixes (MediaTek mt6789)
debug.sf.latch_unsignaled=1
debug.sf.auto_latch_unsignaled=true
ro.surface_flinger.use_content_detection_for_refresh_rate=false

# Native Provisioning / SetupWizard Organ Configuration
# Must be OPTIONAL or ENABLED (never DISABLED) so Keyguard & SystemUI suppress
# the lockscreen and status bar until ArcOSSetupWizard completes provisioning.
ro.setupwizard.mode=OPTIONAL
setupwizard.theme=glif_v4_light

# Privileged Permission Enforcement (Allow custom system organs without crash)
ro.control_privapp_permissions=log

# Early Boot ADB Diagnostics
ro.adb.secure=0
ro.debuggable=1
persist.sys.usb.config=adb
