<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_arc_ambient">

    <LinearLayout
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="64dp"
        android:paddingBottom="44dp"
        android:gravity="center_horizontal">

        <!-- Step Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="40dp">

            <View
                android:id="@+id/dot_1"
                android:layout_width="24dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_arc_button" />

            <View
                android:id="@+id/dot_2"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.3"
                android:background="@drawable/bg_arc_button" />

            <View
                android:id="@+id/dot_3"
                android:layout_width="8dp"
                android:layout_height="6dp"
                android:alpha="0.3"
                android:background="@drawable/bg_arc_button" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <!-- Brand Mark / Badge -->
        <TextView
            android:id="@+id/txt_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARCOS • V0-ALPHA"
            android:textColor="#60A5FA"
            android:textSize="12sp"
            android:letterSpacing="0.18"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="14dp" />

        <!-- Main Title -->
        <TextView
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to ArcOS"
            android:textColor="#F8FAFC"
            android:textSize="34sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginBottom="14dp" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/txt_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engineered from the ground up for fluidity, precision scaling, and native hardware harmony."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:gravity="center"
            android:layout_marginBottom="36dp" />

        <!-- Glass Feature Card -->
        <LinearLayout
            android:id="@+id/feature_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_arc_card"
            android:padding="22dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/txt_feature_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Native System Architecture"
                android:textColor="#F1F5F9"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/txt_feature_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 374 DP (462 DPI) Precision Display Scaling\n• 120Hz AMOLED Latch Optimization\n• Deep Hardware &amp; Haptic Integration"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>

        <!-- Bottom Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Primary Action Button -->
        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_arc_button"
            android:text="Begin Setup"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null" />

    </LinearLayout>
</FrameLayout>
