<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/arcos_bg"
    android:padding="28dp">

    <!-- Center Hero Container (Animates between steps) -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- OEM Badge -->
        <TextView
            android:id="@+id/tv_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_arcos_card"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="6dp"
            android:text="V0-ALPHA  •  ANDROID 16"
            android:textColor="@color/arcos_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <!-- Massive HyperOS/iOS Style Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="ArcOS"
            android:textColor="@color/arcos_text_primary"
            android:textSize="56sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Designed from the ground up.\nFluid. Minimal. Beyond AOSP."
            android:textColor="@color/arcos_text_secondary"
            android:textSize="16sp" />

        <!-- OEM Feature Card (Hidden on Step 1, Shown on Step 2) -->
        <LinearLayout
            android:id="@+id/card_features"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_arcos_card"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_card_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emerald Hardware Engine"
                android:textColor="@color/arcos_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_card_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="• 120Hz High Refresh Rate Enabled\n• 374dp Precision Scaling Locked\n• Full-Screen Gesture Navigation\n• Always-On Display &amp; Haptics Ready"
                android:textColor="@color/arcos_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Pill Button (iOS / HyperOS style) -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_arcos_button"
        android:stateListAnimator="@null"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

</RelativeLayout>
