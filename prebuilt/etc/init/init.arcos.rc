# ArcOS Hardware & Init Services for Redmi Note 13 Pro 4G (emerald)

on post-fs-data
    # Ensure Xiaomi Mi Display & Touch FOD nodes are writable by system and root
    chmod 0666 /sys/devices/virtual/mi_display/disp_feature/disp-DSI-0/disp_param
    chmod 0666 /sys/class/mi_display/disp-DSI-0/disp_param
    chmod 0666 /sys/class/touch/touch_dev/fod_press_status

on property:sys.boot_completed=1
    start arcos_init
    start arcos_udfps

service arcos_init /system/bin/sh /system/bin/arcos_init.sh
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:su:s0

service arcos_udfps /system/bin/sh /system/bin/arcos_udfps.sh
    user system
    group system root log
    disabled
    seclabel u:r:system_server:s0
